{% extends "layouts/_base.njk" %}

{% block main_content %}
  <h1>Create new trail</h1>
  <form method="POST" action="/admin/trails/new">
    <!-- Trail title -->
    <div>
      <label for="title">Title</label>
      <input type="text" id="title" name="title"
             value="{{ trail.title | default('') }}" required>
    </div>

    <div style='display:flex; gap:1.5rem;'>
      <!-- Trail difficulty -->
      <div>
        <label for="difficulty">Difficulty</label>
        <select id="difficulty" name='difficulty' required>
          <option value="">--Please choose an option--</option>
          <option value="easy">Easy</option>
          <option value="moderate">Moderate</option>
          <option value="hard">Hard</option>
        </select>
      </div>

      <!-- Trail distance -->
      <div>
        <label for="distance">Distance</label>
        <input type="number" id="distance" name="distance"
               value="{{ trail.distance_km | default('') }}" required min='0'
               step='0.1'>
      </div>
    </div>

    <!-- Trail description -->
    <div>
      <label for="description">Description</label>
      <textarea id="description" name="story" rows="5" cols="33" required>
      Trail description here...
      </textarea>
    </div>

    <!-- Trail image -->
    <div>
      <label for="image_url">Image URL</label>
      <input type="text" id="title" name="image_url"
             value="{{ trail.image_url | default('') }}" required>
    </div>

    <input type="submit">
    <input type="button" class="secondary" value="cancel">
  </form>
{% endblock %}
