{% extends "layouts/_base.njk" %}
{% from "macros/trail-card.njk" import trailCard %}

{% block hero %}
  <header class='hero-home'>
    <hgroup>
      <h1>Trails List</h1>
    </hgroup>
  </header>
{% endblock %}
{% block main_content %}
  <hr>
  <section class='search'>
    <form method="GET" action='/trails'>
      <div class='grid'>
        <!-- Search term-->
        <div>
          <label for="q">Search trails</label>
          <input id="q" type="text" name="q"
                 value="{{ filters.q | default('') }}"
                 placeholder="Zugspitze via Reintal.."/>
        </div>

        <!-- Search trails by region-->
        <div>
          <label for="region">Region</label>
          <select id="region" name="region">
            <option value="">--Please choose an option--</option>
            {% for region in regions %}
              <option value="{{ region.slug }}" {{ 'selected' if filters.region == region.slug }}>{{region.name | default('') }}</option>
            {% endfor %}
          </select>
        </div>

        <!-- Search trails by difficulty-->
        <div style='flex:1; min-width:0;'>
          <label for="difficulty">Difficulty</label>
          <select id="difficulty" name='difficulty'>
            <option value="">--Please choose an option--</option>
            <option value="easy" {{ 'selected' if filters.difficulty == 'easy' }}>Easy</option>
            <option value="moderate" {{ 'selected' if filters.difficulty == 'moderate' }}>Moderate</option>
            <option value="hard" {{ 'selected' if filters.difficulty == 'hard' }}>Hard</option>
          </select>
        </div>

        <!-- Search trail by distance -->
        <div style='flex:1; min-width:0;'>
          <label for="maxDistance">Max distance (km)</label>
          <input type="number" id="maxDistance" name="maxDistance" placeholder="e.g. 10"
                 value="{{ filters.maxDistance | default('') }}" min='0'
                 step='0.1'>
        </div>

        <input type="submit" value="Search">
      </div>
    </form>

  </section>
  <section class='grid'>
    {% if trails.length %}

      {% for trail in trails %}
        {{ trailCard(trail) }}
      {% endfor %}

    {% else %}

      <article>
        <p>No trails available yet.</p>
      </article>

    {% endif %}
  </section>
{% endblock %}
