{
  "name": "trail-guide",
  "version": "1.0.0",
  "description": "trail-guide project which is second recap-project of the neufische's Advanced Sopftware Devlopment with AI Bootcamp",
  "type": "module",
  "keywords": [
    "Express",
    "MVC",
    "SQL",
    "Nunjucks",
    "Templating"
  ],
  "license": "ISC",
  "author": "",
  "main": "app.ts",
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "build": "bun build src/app.ts --outdir dist --target bun && cp -r public dist/public",
    "start": "bun dist/app.js",
    "db:seed": "sqlite3 data/trail-guide.db < data/seed.sql",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "@types/cors": "^2.8.19",
    "chokidar": "^3.6.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "nunjucks": "^3.2.4",
    "quill": "^2.0.3",
    "sanitize-html": "^2.17.6",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/nunjucks": "^3.2.6",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-sql": "^3.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sqlite3@6.0.1": true,
    "fsevents@2.3.3": true,
    "multiline-ts@4.0.1": true
  }
}
